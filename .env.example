# Example environment variables file
# Copy this file to .env and edit

# Debug mode
DEBUG=false

# Download directory
DOWNLOAD_DIR=/tmp/insta_downloads

# Concurrent download limit
MAX_CONCURRENT_DOWNLOADS=3

# Download timeout (seconds)
DOWNLOAD_TIMEOUT=300

# Instagram authentication (use either sessionid OR username/password)
# Option 1: Session ID (get from browser cookies after logging in)
IG_SESSIONID=

# Option 2: Username and password (creates a new session)
IG_USERNAME=
IG_PASSWORD=

# Custom User Agent (optional)
IG_USER_AGENT=

# Proxy settings (JSON array format)
# Example: ["http://proxy1:port", "http://user:pass@proxy2:port"]
PROXIES=[]

# Enable proxy rotation on failures
PROXY_ROTATION=true

# Max retry attempts with proxy rotation
PROXY_RETRY_MAX=4

# Backoff settings for rate limiting
PROXY_BACKOFF_BASE=1.5
PROXY_BACKOFF_JITTER=0.5

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_PERIOD=60

# Automatic cleanup
AUTO_CLEANUP=true
CLEANUP_AFTER_SECONDS=300
